    "lc.appSettings.hideAppDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأخفاء البرامج بالكامل، فعل ميزة الاخفاء بالاعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Apps vollständig auszublenden, aktivieren Sie den Modus \"Striktes Ausblenden\" in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To completely hide apps, enable Strict Hiding mode in settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ocultar completamente las apps, activa el modo de ocultación estricta en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour masquer complètement les applications, activez le mode de masquage strict dans les paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per nascondere completamente le applicazioni, abilita la modalità Strict Hiding nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを完全に隠すには、設定で｢厳重な非表示モード｣をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 완전히 숨길려면, 설정에서 고급 숨김 모드를 활성화해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby całkowicie ukryć aplikacje, Włącz opcje \"Ścisłe ukrywanie\" w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para esconder os aplicativos completamente, ative o 'Modo de Ocultação Robusto' nas configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы полностью скрыть приложения, включите строгий режим скрытия в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att helt dölja appar, aktivera Strict Hiding mode i inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaları tamamen gizlemek için ayarlarda Sıkı Gizleme modunu etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ẩn app hoàn toàn, bật chế độ Ẩn Nghiêm Ngặt trong cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要完全隐藏App，请在设置中启用严格隐藏模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要完全隱藏應用程式，請在設定中啟用嚴格隱藏模式。"
          }
        }
      }
    },
