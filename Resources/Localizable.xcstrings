    "lc.appSettings.launchWithJitDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يحاول GameCase بالحصول على JIT قبل ان يُشغل التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase wird vor dem Start der App versuchen, die JIT-Berechtigung zu erlangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase will try to acquire JIT permission before launching the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase intentará obtener permiso JIT antes de lanzar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase essaiera d'obtenir l'autorisation de JIT avant de lancer l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase proverà ad acquisire i permessi JIT prima di lanciare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCaseはアプリを起動する前にJIT権限の取得を試みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 실행 전 JIT 권한 접근을 시도합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase spróbuje dostać uprawnienia JIT przed uruchomieniem aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase tentará adquirir a permissão para obter a compilação 'JIT' antes de iniciar o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase попытается получить разрешение JIT перед запуском приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase kommer att försöka skaffa JIT-tillstånd innan appen startas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase, uygulamayı başlatmadan önce JIT iznini almaya çalışacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase sẽ thử nhận quyền JIT trước khi mở app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启动App前GameCase会尝试获取JIT权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動應用程式之前，GameCase將嘗試獲取JIT許可權。"
          }
        }
      }
    },
