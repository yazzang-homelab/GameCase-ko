    "lc.appList.installReplaceTip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنالك تطبيق موجود بالفعل بهذا معرف الحزمه. بدل هذا المعرف او ثبت كجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine App mit demselben Bundle-Identifikator. Ersetzen Sie sie oder installieren Sie sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is an existing application with the same bundle identifier. Replace one or install as new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una aplicación con el mismo identificador de paquete. Reemplázala o instala como nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe une application existante avec le même identifiant de paquet. Remplacez-la ou installez-la en tant que nouvelle application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è già un'applicazione con lo stesso Bundle ID. Sostituiscilo o installa come nuova applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じバンドル識別子を持つ既存のアプリがあります。置き換えるか、新規インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 번들 식별자를 갖고 있는 앱이 존재합니다. 기존에 설치되어 있는 앱에 덮어씌우거나 새로운 앱으로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja z taką samą nazwą pakietu już istnieje. Zastąpić ją, czy zainstalować ją jako nową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um aplicativo existente com o mesmo identificador de pacote de outro aplicativo. Substitua um deles ou instale como novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже установлено другое приложение с тем же ИД пакета. Хотите ли вы его обновить, либо установить в качестве нового?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ett befintligt app med samma bundle identifierare. Ersätt en eller installera som ny."
