      }
    },
    "lc.datapack.folderRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a datapack folder: no romfs.img or aoc folder at its top level. A loose folder of romfs files can't be mounted — pack it into romfs.img first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是数据包文件夹：顶层没有 romfs.img 或 aoc 文件夹。散装的 romfs 文件夹无法挂载，请先打包成 romfs.img。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma pasta de pacote de dados: não há romfs.img nem pasta aoc no nível principal. Uma pasta solta de arquivos romfs não pode ser montada — empacote-a em romfs.img primeiro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 팩 폴더가 아닙니다. 최상위에 romfs.img나 aoc 폴더가 없습니다. 풀어 놓은 romfs 폴더는 마운트할 수 없으니 먼저 romfs.img로 묶으십시오."
          }
        }
      }
    },
