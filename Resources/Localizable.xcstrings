    "lc.mods.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mods are folders in this game's data folder under Documents/mods/. Import and manage them here, or drop them in with the Files app. They stack in the order listed, the first one wins for the same file, and changes take effect on the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod 是这款游戏数据目录 Documents/mods/ 里的文件夹，可在这里导入管理，也可以用「文件」App 放入。按列表顺序叠加，同一文件以先列的为准，改动下次启动生效。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mods são pastas na pasta de dados deste jogo, em Documents/mods/. Importe e gerencie aqui ou adicione pelo app Arquivos. Eles são aplicados na ordem da lista, o primeiro prevalece quando há o mesmo arquivo, e as alterações valem a partir da próxima inicialização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드는 이 게임 데이터 폴더의 Documents/mods/ 안에 있는 폴더입니다. 여기서 가져와 관리하거나 ‘파일’ 앱으로 넣을 수 있습니다. 목록 순서대로 겹쳐지며 같은 파일은 위쪽 모드가 우선합니다. 변경 사항은 다음 실행부터 적용됩니다."
          }
        }
      }
    },
