    "lc.mods.importInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder can't be used as a mod: RomFS files must sit in a romfs subfolder, an Atmosphere-style contents layout, or directly in the folder. Code-only (exefs) mods aren't supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件夹不能用作 Mod：RomFS 文件需放在 romfs 子文件夹、大气层式 contents 布局里，或直接放在文件夹根目录。仅含 exefs 的纯代码 Mod 不支持。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta não pode ser usada como mod: os arquivos RomFS devem estar em uma subpasta romfs, em uma estrutura contents no estilo Atmosphere ou diretamente na pasta. Mods só de código (exefs) não são suportados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 모드로 쓸 수 없습니다. RomFS 파일이 romfs 하위 폴더나 Atmosphere 방식의 contents 구조, 또는 폴더 바로 아래에 있어야 합니다. 코드만 있는(exefs) 모드는 지원하지 않습니다."
          }
        }
      }
    },
