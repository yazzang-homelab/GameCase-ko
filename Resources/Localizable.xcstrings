    "lc.settings.multiLCInstallAlertDesc %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يقوم GameCase بتوليد ملف الـipa لـGameCase أخر. الرجاء مشاركته إلى %@ للتثبيت، هل تود المتابعه؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase wird eine IPA für einen weiteren GameCase generieren. Bitte teilen Sie diese mit %@, um sie zu installieren. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase will generate the ipa for another GameCase. Please share it to %@ to install it, Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase generará el ipa para otro GameCase. Compártelo con %@ para instalarlo. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase va générer l'IPA pour un autre GameCase. Veuillez le partager à %@ pour l'installer. Continuer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase genererà l'ipa per un altro GameCase. Condividilo su %@ per installarlo, Vuoi Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCaseは別のGameCase用のIPAを生成します。インストールするには%@に共有してください。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 다운로드가 완료되면, %@(으)로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase wygeneruje plik ipa dla innego GameCase. Proszę udostępnić go do %@ aby go zainstalować. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner atual irá gerar o arquivo IPA para outro contêiner. Por favor, compartilhe-o para %@ para concluir a instalação. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase создаст файл IPA для другого GameCase'а. Поделитесь им с %@, чтобы завершить установку. Хотите продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase kommer att generera ipa för en annan GameCase. Vänligen dela den till %@ för att installera den, Fortsätt?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase, başka bir GameCase için ipa dosyası oluşturacaktır. Yüklemek için lütfen %@ ile paylaşın, devam etmek ister misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase sẽ tạo file ipa cho GameCase khác. Hãy chia sẻ nó qua %@ để cài nó. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase将会生成另一个GameCase的IPA，请将其分享至%@以安装。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase會產生IPA來安裝另一個GameCase。如要安裝請分享至%@。"
          }
        }
      }
    },
