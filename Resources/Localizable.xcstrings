    "lc.settings.noDataFolderToClean": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف بيانات للحذف. جميع ملفات البيانات مستعمله حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
