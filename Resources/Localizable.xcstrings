      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cheat files yet. Import below, or place build-ID-named .txt files in Documents/cheats/."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有金手指。用下方按钮导入，或把以 build ID 命名的 .txt 文件放进 Documents/cheats/。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo de cheats ainda. Importe abaixo ou coloque arquivos .txt nomeados pelo build ID em Documents/cheats/."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치트 파일이 없습니다. 아래에서 가져오거나, 빌드 ID로 이름 붙인 .txt 파일을 Documents/cheats/에 넣으십시오."
          }
        }
      }
    },
    "lc.cheats.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheat files sit in this game's data folder under Documents/cheats/, named by the game's build ID. On iOS, entries that patch game code are switched off by the engine automatically (the reason is written to the game log); entries that only write data do take effect. Changes apply on the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金手指文件在这款游戏数据目录的 Documents/cheats/ 里，按游戏 build ID 命名。在 iOS 上，修改游戏代码的条目会被引擎自动关停（原因会写进游戏日志），只写数据的条目可以生效。改动下次启动生效。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de cheats ficam na pasta de dados deste jogo, em Documents/cheats/, nomeados pelo build ID do jogo. No iOS, entradas que modificam o código do jogo são desativadas automaticamente pelo motor (o motivo é registrado no log do jogo); entradas que apenas gravam dados funcionam normalmente. As alterações valem a partir da próxima inicialização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치트 파일은 이 게임 데이터 폴더의 Documents/cheats/에 게임 빌드 ID 이름으로 저장됩니다. iOS에서는 게임 코드를 수정하는 항목을 엔진이 자동으로 끄며(이유는 게임 로그에 기록됩니다), 데이터만 쓰는 항목은 적용됩니다. 변경 사항은 다음 실행부터 적용됩니다."
          }
        }
      }
    },
