            "state": "translated",
            "value": "Debes importar el certificado ADP antes de probar el modo JIT-Less."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez importer le certificat ADP avant de tester le mode sans JIT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi importare il certificato ADP prima di testare la modalità JIT-Less."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JITレスモードテストをする前に、ADP証明書をインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-Less 모드를 테스트하려면 ADP 인증서가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz zaimportować certyfikat ADP przed testowaniem trybu JIT-Less."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deve importar certificado ADP antes de testar o modo JIT-Less."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы должны импортировать сертификат, прежде чем вы проверите режим JIT-less."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste importera ADP-certifikat innan du testar JIT-Less läge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-Less modu test etmeden önce ADP sertifikasını içe aktarmalısınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải nhập chứng chỉ ADP trước khi thử chế độ JIT-Less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在测试免JIT模式前，你必须要先导入开发者证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在測試免JIT模式前，你需要先匯入開發者證書。"
          }
        }
