    "lc.settings.signer.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أذا أعطى AltSign خطأ، فحاول أن تستعمل Zsign و العكس صحيح. الرجاء اعادة تشغيل التطبيق GameCase بعد تغيير الُموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn AltSign einen Fehler meldet, versuchen Sie es bitte mit ZSign und andersherum. Bitte starten Sie GameCase nach dem Wechsel des Signierers neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If AltSign reports an error, please try ZSign and vice versa. Please restart GameCase after switching Signer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si AltSign signale une erreur, essayez ZSign et vice versa. Veuillez redémarrer GameCase après avoir changé de signataire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltSign でエラーが発生する場合は、ZSign をお試しください。また、反対にZSignでエラーが発生する場合は、AltSignをお試しください。Signer を切り替えた後、 GameCase を再起動してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se AltSign não funcionar corretamente, por favor tente mudar para ZSign e vice-versa. Por favor, reinicie GameCase após alterar o método de assinar os aplicativos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om AltSign rapporterar ett fel, försök ZSign och vice versa. Starta om GameCase efter byte av Signer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若AltSign签名遇到问题，可尝试使用ZSign，反之亦然。切换签名工具后请重启GameCase。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AltSign에서 오류가 나면 ZSign을, ZSign에서 오류가 나면 AltSign을 써 보십시오. 서명 도구를 바꾼 뒤에는 GameCase를 다시 시작하십시오."
          }
        }
      }
    },
    "lc.settings.silentOpenWebPage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الروابط دائمًا في التطبيق الحالي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL immer in der aktuellen App öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Open URL in Current App"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir siempre la URL en la app actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours ouvrir l'URL dans l'application en cours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri sempre l'URL nell'app corrente"
          }
        },
        "ja": {
          "stringUnit": {
