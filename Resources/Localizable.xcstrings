        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto wbudowany SideStore. Czy chcesz zaimportować z niego certyfikat?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore integrada detectada. Gostaria de importar o certificado dela?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен встроенный SideStore. Хотите ли вы импортировать сертификат оттуда?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik SideStore algılandı. Buradan sertifikayı içe aktarmak ister misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện SideStore tích hợp. Bạn có muốn nhập chứng chỉ từ đó không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到内置SideStore，你想从中导入证书吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到內建Sideload，你想要從中匯入證書嗎？"
          }
        }
      }
    },
