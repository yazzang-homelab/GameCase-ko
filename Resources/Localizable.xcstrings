    "lc.cheats.importInvalidName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped “%@”: cheat files must be named by the game's 16-digit build ID, e.g. FC9EA4CCC955D579.txt — the engine finds cheat files by name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过「%@」：金手指文件名必须是游戏的 16 位 build ID（如 FC9EA4CCC955D579.txt），引擎靠文件名找金手指包。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ignorado: os arquivos de cheats devem ter como nome o build ID de 16 dígitos do jogo, ex.: FC9EA4CCC955D579.txt — o motor encontra os arquivos de cheats pelo nome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 건너뜀: 치트 파일 이름은 게임의 16자리 빌드 ID여야 합니다(예: FC9EA4CCC955D579.txt). 엔진이 파일 이름으로 치트를 찾습니다."
          }
        }
      }
    },
