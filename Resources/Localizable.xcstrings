    "lc.cloud.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves sync automatically to the folder you choose in iCloud Drive. Pick the same folder you use on your Mac or in the standalone build and the saves are shared. Takes effect on the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档会自动同步到所选的 iCloud Drive 文件夹。选和 Mac、单机版相同的文件夹，存档即可互通。设置下次启动生效。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saves são sincronizados automaticamente com a pasta que você escolher no iCloud Drive. Escolha a mesma pasta que você usa no Mac ou na versão independente e os saves serão compartilhados. Entra em vigor na próxima inicialização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이브가 iCloud Drive의 선택한 폴더로 자동 동기화됩니다. Mac이나 단독 빌드에서 쓰는 폴더와 같은 폴더를 고르면 세이브를 함께 씁니다. 다음 실행부터 적용됩니다."
          }
        }
      }
    },
