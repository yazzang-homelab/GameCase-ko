    "lc.settings.multiLCLaunchPriorityDesc": {
      "comment": "Drag LiveContainers to choose which one is tried first when launching shared apps.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب GameCase لاختيار أي واحد يتم تجربته أولا عند تشغيل التطبيقات المشتركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die GameCase, um festzulegen, welche App zuerst gestartet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag GameCases to choose which one is tried first when launching shared apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los GameCase para elegir cuál se intenta primero al lanzar apps compartidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les GameCase pour choisir lequel est essayé en premier lors du lancement d'applications partagées."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij GameCase, aby wybrać, który z nich zostanie wypróbowany jako pierwszy podczas uruchamiania udostępnionych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os GameCases para escolher qual será tentado primeiro ao iniciar apps compartilhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте GameCase'ы, чтобы выбрать, какой из них будет использован при запуске общих приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan uygulamalar başlatılırken önce hangisinin deneneceğini belirlemek için GameCase’ları sürükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các GameCase để chọn cái nào được thử trước khi chạy app được chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 GameCase 来设置启动共享 App 时的尝试顺序。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase를 끌어서 공유 앱을 실행할 때 먼저 시도할 순서를 정합니다."
          }
        }
      }
    },
