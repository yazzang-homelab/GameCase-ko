    "lc.gameState.needsDatapackExplanation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏本体已经装好，还差数据包，导入后就能玩。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game itself is installed, but it still needs its datapack. Import it and you're ready to play."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo já está instalado, mas ainda falta o pacote de dados. Importe-o e já dá para jogar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 본체는 설치되었지만 데이터 팩이 필요합니다. 가져오면 바로 플레이할 수 있습니다."
          }
        }
      }
    },
    "lc.gameState.needsDatapackFix": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「导入数据包…」，选这款游戏的数据包文件 romfs.img，或选装着数据包的文件夹。数据包要和游戏版本配套，导错版本启动时会报错，原因会写在日志里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Import Datapack…\" and pick this game's datapack file, romfs.img, or a folder containing the datapack. The datapack must match the game version; a wrong version will fail at launch, and the reason will be written to the log."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Importar pacote de dados…\" e escolha o arquivo romfs.img deste jogo, ou uma pasta que contenha o pacote de dados. O pacote precisa corresponder à versão do jogo; uma versão errada dá erro ao abrir, e o motivo fica registrado no log."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“데이터 팩 가져오기…”를 누르고 이 게임의 데이터 팩 파일 romfs.img 또는 데이터 팩이 든 폴더를 선택하십시오. 데이터 팩은 게임 버전과 맞아야 합니다. 버전이 다르면 실행할 때 실패하며 원인이 로그에 기록됩니다."
          }
        }
      }
    },
    "lc.gameState.folderOccupiesReason": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据包位置被文件夹占用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder is in the datapack's place"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta está no lugar do pacote de dados"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 팩 자리에 폴더가 있음"
          }
        }
      }
    },
    "lc.gameState.folderOccupiesDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器里 romfs.img 本该是个文件，现在却是个文件夹，多半是解压或拷贝时放错了。先到「文件」里把这个文件夹删掉，再重新导入数据包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "romfs.img in the container should be a file, but it's a folder — most likely something went wrong while extracting or copying. Delete that folder in Files first, then import the datapack again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O romfs.img no contêiner deveria ser um arquivo, mas é uma pasta — provavelmente algo deu errado ao extrair ou copiar. Apague essa pasta no app Arquivos e importe o pacote de dados de novo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너의 romfs.img는 파일이어야 하는데 폴더입니다. 압축을 풀거나 복사할 때 잘못 놓인 것으로 보입니다. 먼저 ‘파일’ 앱에서 그 폴더를 삭제한 뒤 데이터 팩을 다시 가져오십시오."
          }
        }
      }
    },
    "lc.gameState.folderOccupiesTechnical %@": {
