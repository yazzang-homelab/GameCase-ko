    "lc.bootstrap.error.jitlessRequiredSinceIOS26": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JITLess mode is required since iOS 26. Please set it up in settings. \nPlease go to LiveContainer settings -> tap \"Import Certificate from SideStore\" / \"Import Certificate\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 起必须使用免 JIT 模式，请先在设置中完成配置。\n请前往 GameCase 设置 -> 点按“从 SideStore 导入证书”/“导入证书”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo JITLess é necessário a partir do iOS 26. Configure-o primeiro nos ajustes.\nVá para os ajustes do GameCase -> toque em \"Importar Certificado do SideStore\" / \"Importar Certificado\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26부터는 JIT-Less 모드가 필요합니다. 설정에서 구성하십시오.\nGameCase 설정에서 “SideStore에서 인증서 가져오기” 또는 “인증서 가져오기”를 누르십시오."
          }
        }
      }
    },
    "lc.bootstrap.error.jitNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT was not enabled. If you want to use LiveContainer without JIT, setup JITLess mode in settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 未启用。如果想在没有 JIT 的情况下使用 GameCase，请在设置中配置免 JIT 模式。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O JIT não foi ativado. Se quiser usar o GameCase sem JIT, configure o modo JITLess nos ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT가 켜져 있지 않습니다. JIT 없이 GameCase를 쓰려면 설정에서 JIT-Less 모드를 구성하십시오."
          }
        }
      }
    },
