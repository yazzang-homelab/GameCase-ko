    "lc.gameState.emptyDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器里的数据包只有 0 字节，应该是没传完或拷贝中断过。重新导入一次完整的数据包，覆盖掉它就好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The datapack in the container is 0 bytes, probably because a transfer or copy was interrupted. Just import a complete datapack again to replace it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote de dados no contêiner tem 0 bytes, provavelmente porque a transferência ou cópia foi interrompida. É só importar de novo um pacote completo para substituí-lo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너의 데이터 팩이 0바이트입니다. 전송이나 복사가 중단된 것으로 보입니다. 온전한 데이터 팩을 다시 가져와 교체하십시오."
          }
        }
      }
    },
    "lc.gameState.emptyTechnical %@": {
      "extractionState": "manual",
      "localizations": {
