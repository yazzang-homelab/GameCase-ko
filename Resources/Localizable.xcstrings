    "lc.cheats.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cheat file “%@” and its on/off choices will be removed from this game's data. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金手指文件「%@」及其条目开关设置将从这款游戏的数据中删除，无法撤销。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de cheats “%@” e as escolhas de ativar/desativar dele serão removidos dos dados deste jogo. Isso não pode ser desfeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치트 파일 “%@”과 항목별 켜기/끄기 설정을 이 게임의 데이터에서 삭제합니다. 되돌릴 수 없습니다."
          }
        }
      }
    },
