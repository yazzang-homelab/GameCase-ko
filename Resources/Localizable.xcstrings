          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'yı kaldırmak istediğinizden emin misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xoá %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要卸载%@吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝%@？"
          }
        }
      }
