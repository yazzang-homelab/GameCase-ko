    "lc.settings.importCertFromBuiltinSideStore.certNotFounndErr": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على الشهادة. هل سجلت الدخول إلى SideStore المُدمج؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat nicht gefunden. Haben Sie sich bei der integrierten SideStore-Version angemeldet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificate not found. Did you log into built-in SideStore?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado no encontrado. ¿Has iniciado sesión en SideStore?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificat introuvable. Vous êtes-vous connecté au SideStore intégré ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificato non trovato. Hai eseguito l'accesso al SideStore integrato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書が見つかりません。内蔵のSideStoreにサインインしているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
