          }
        }
      }
    },
    "lc.appSettings.toSharedAppDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل هذا التطبيق إلى مجموعة التطبيقات يسمح للحاويات الأخرى بتشغيل هذا التطبيق مع جميع بياناته وتعديلاتك محفوظة. إذا كنت ترغب في الوصول إلى بياناته وتعديلاتك مرة أخرى من تطبيق الملفات، قم بنقله مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verschieben dieser App in die App-Gruppe ermöglicht es anderen GameCasen, diese App mit allen Daten und Einstellungen auszuführen. Wenn Sie von der Datei-App aus wieder auf die Daten und Einstellungen zugreifen möchten, verschieben Sie sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving this app to App Group allows other GameCases to run this app with all its data and tweak preserved. If you want to access its data and tweak again from the file app, move it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover esta app al grupo de apps permite que otros GameCase la ejecuten conservando todos sus datos y tweaks. Si quieres volver a acceder a sus datos y tweaks desde la app Archivos, muévela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer cette application vers un groupe d'apps permet à d'autres GameCase de lancer cette application en conservant toutes ses données et ses tweaks. Si vous voulez accéder à nouveau à ses données et à ses tweaks à partir de l'application Fichiers, déplacez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostando quest'app nel Gruppo App permette ad altri GameCase di eseguire quest'app con tutti i i suoi dati e tweak preservati. Se vuoi accedere di nuovo ai suoi dati e tweak dai file dell'app, spostali indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリをアプリグループに移動すると、他のGameCaseからもこのアプリをデータや調整を保持したまま実行できるようになります。ファイルアプリから再びデータや調整にアクセスしたい場合は元に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 앱으로 전환 시, 다른 GameCase에서도 실행이 가능해집니다. 다만, 파일 앱에서 데이터 및 트윅 접근이 제한됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie tej aplikacji do Grupy Aplikacji pozwala innym GameCase’om uruchamiać tę aplikację z wszystkimi danymi oraz modyfikacjami. Jeżeli chcesz mieć dostęp do aplikacji oraz modyfikacji z aplikacji \"Pliki\", przenieś ją z powrotem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover este aplicativo para os Aplicativos Agrupados irá permitir outros que outros contêineres executem o aplicativo com todos os seus dados e ajustes preservados. Se você quer acessar os dados e os ajustes do aplicativo novamente por meio do aplicativo de arquivos, por favor, mova-o de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение данного приложения в App Group позволит другим GameCase запускать это приложение, сохранив все данные и твики. Если вам снова понадобится доступ к данным и твикам приложения, переместите его обратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att flytta denna app till App Group kan andra GameCase köra denna app med alla dess data och tweaks bevarade. Om du vill komma åt dess data och justera igen från filappen, flytta den tillbaka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı Uygulama Grubuna taşıyarak, diğer GameCase'ların tüm verileri ve ayarları korunarak bu uygulamayı çalıştırmasını sağlayabilirsiniz. Verilerine ve ayarlarına dosya uygulamasından tekrar erişmek istiyorsanız, uygulamayı geri taşıyın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển app này sang App Group cho phép các GameCase khác mở app này với dữ liệu và tweak như cũ. Nếu bạn muốn truy cập dữ liệu và tweak từ app tệp thì di chuyển nó lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此App移动到AppGroup以允许其他GameCase运行此App，并保留其所有数据和模块。如果你想访问它的数据和模块，请将其转换为私有App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此應用程式移動到應用程式組允許其他GameCase執行此應用程式，並保留其所有資料和補訂。 如果您想訪問其資料並從檔案應用程式中再次調整，請將其移回。"
          }
        }
      }
    },
    "lc.appSettings.tweakFolder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
