            "state": "translated",
            "value": "No hay carpetas de datos que eliminar. Todas están en uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier de données à supprimer. Tous les dossiers de données sont utilisés."
          }
        },
        "it": {
