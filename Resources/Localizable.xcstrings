    "lc.gameState.unreadableDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据包文件在容器里，但系统读不到它的信息。重新导入一次数据包覆盖它；还是不行，把日志发给开发者看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The datapack file is in the container, but the system can't read its info. Import the datapack again to replace it; if that doesn't help, send the log to the developer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo do pacote de dados está no contêiner, mas o sistema não consegue ler as informações dele. Importe o pacote de novo para substituí-lo; se não resolver, envie o log para o desenvolvedor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 팩 파일이 컨테이너에 있지만 시스템이 파일 정보를 읽지 못합니다. 데이터 팩을 다시 가져와 교체하십시오. 그래도 안 되면 로그를 개발자에게 보내십시오."
          }
        }
      }
    },
    "lc.gameState.unreadableTechnical %@": {
