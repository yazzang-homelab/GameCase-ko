    "lc.gameState.mismatchReason": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据包与游戏版本不匹配"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Datapack doesn't match game version"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacote de dados não corresponde à versão do jogo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 팩이 게임 버전과 맞지 않음"
          }
        }
      }
    },
    "lc.gameState.mismatchDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在这份数据包不是这款游戏当前版本配套的那一份，大小对不上。重新导入配套的数据包；刚更新过游戏的话，旧数据包一般也要跟着换新版。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This datapack isn't the one that matches the game's current version — the size doesn't match. Import the matching datapack; if you just updated the game, the old datapack usually needs to be replaced with the new version too."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote de dados não é o que corresponde à versão atual do jogo — o tamanho não bate. Importe o pacote correspondente; se você acabou de atualizar o jogo, normalmente o pacote antigo também precisa ser trocado pela versão nova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터 팩은 게임의 현재 버전과 맞는 것이 아니며 크기가 일치하지 않습니다. 맞는 데이터 팩을 가져오십시오. 게임을 방금 업데이트했다면 데이터 팩도 대개 새 버전으로 바꿔야 합니다."
          }
        }
      }
    },
