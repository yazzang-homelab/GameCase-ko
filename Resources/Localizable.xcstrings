    "lc.settings.injectLCItselfDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع تعديلاتك على مِلَفّ التعديلات العالمي و GameCase سوف يأخذهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Ihre Tweaks in den globalen Tweak-Ordner und GameCase wird sie aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your tweaks into the global “Tweaks” folder and GameCase will pick them up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos tweaks dans le dossier global \"Tweaks\" et GameCase les récupérera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、GameCase は自動的にグローバルモジュールフォルダー内のモジュールをロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seus ajustes na pasta global com nome de \"Ajustes\" e o GameCase irá identificá-los."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera din tweaks i den globala “Tweaks” mappen och GameCase kommer att plocka upp dem."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ các tweak vào thư mục công cộng “Tweaks” và GameCase sẽ dùng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
