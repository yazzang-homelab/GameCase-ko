    "lc.appSettings.classicModeDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Guides the system to display the app at the appropriate resolution. On iPad OS, the app will be displayed in iPhone mode if it does not natively support iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Faz o sistema exibir o app na resolução adequada. No iPadOS, o app será exibido no modo iPhone se não tiver suporte nativo a iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（实验性）引导系统以合适的分辨率显示 App。在 iPadOS 上，未原生支持 iPad 的 App 将以 iPhone 模式显示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(실험적) 시스템이 앱을 알맞은 해상도로 표시하도록 유도합니다. iPadOS에서 iPad를 기본 지원하지 않는 앱은 iPhone 모드로 표시됩니다."
          }
        }
      }
    },
