    "lc.datapack.folderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder's top level must contain romfs.img and/or an aoc folder. Its contents are copied into this game's Documents: romfs.img replaces the datapack, aoc is replaced as a whole."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹顶层须包含 romfs.img 和/或 aoc 文件夹，内容会拷入该游戏的 Documents：romfs.img 替换数据包，aoc 整夹替换。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nível principal da pasta deve conter romfs.img e/ou uma pasta aoc. O conteúdo é copiado para o Documents deste jogo: romfs.img substitui o pacote de dados e a pasta aoc é substituída por inteiro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 최상위에 romfs.img 또는 aoc 폴더(혹은 둘 다)가 있어야 합니다. 내용은 이 게임의 Documents로 복사됩니다. romfs.img는 데이터 팩을 교체하고, aoc는 폴더째 교체됩니다."
          }
        }
      }
    },
    "lc.datapack.folderOverwriteButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace with Folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用文件夹替换"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir pela Pasta"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더로 교체"
          }
        }
      }
    },
    "lc.datapack.folderOverwriteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing this folder replaces the current datapack (%@) and any existing aoc content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入这个文件夹会替换当前数据包（%@）与已有的 aoc 内容。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar esta pasta substitui o pacote de dados atual (%@) e qualquer conteúdo aoc existente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 가져오면 현재 데이터 팩(%@)과 기존 aoc 내용이 교체됩니다."
          }
        }
      }
    },
    "lc.datapack.folderOverwriteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Datapack Already Exists"
          }
        },
        "zh-Hans": {
