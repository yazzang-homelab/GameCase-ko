    "lc.gameHome.hiddenGamesDesc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些游戏被隐藏，不出现在游戏库里。长按一行可启动、打开设置或卸载；点「取消隐藏」即恢复显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These games are hidden and don't appear in your library. Long-press a row to launch, open settings or uninstall; tap “Unhide” to show it again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes jogos estão ocultos e não aparecem na sua biblioteca. Toque e segure uma linha para iniciar, abrir as configurações ou desinstalar; toque em “Mostrar” para exibi-lo de novo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 게임은 보관함에 표시되지 않습니다. 항목을 길게 누르면 실행, 설정 열기, 제거를 할 수 있고 “숨김 해제”를 누르면 다시 표시됩니다."
          }
        }
      }
    },
