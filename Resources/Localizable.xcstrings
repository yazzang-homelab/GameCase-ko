    "lc.settings.error.certNotImported": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب عليك أن تَستَورِدَ شهادة ADP قبل اختبار وضع بدون-JIT."
          }
        },
        "de": {
          "stringUnit": {
