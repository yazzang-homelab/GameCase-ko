    "lc.appSettings.forceSignDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول التوقيع مره أخرى أذا التطبيق فشل فالتشغيل ويُظهر خطأ مثل 'توقيع غير صالح' أذا هذا لم يعمل، حاول أن تعيد شهاده بدون-JIT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie erneut zu signieren, wenn diese App mit der Fehlermeldung \"Ungültige Signatur\" nicht gestartet werden konnte. Wenn es immer noch nicht funktioniert, erneuern Sie das JIT-Less-Zertifikat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to sign again if this app failed to launch with error like 'Invalid Signature'. If this still doesn't work, renew JIT-Less certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta firmar de nuevo si esta app falla al iniciarse con un error como 'Firma no válida'. Si esto sigue sin funcionar, renueva el certificado JIT-Less."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de signer à nouveau si l'application ne s'est pas lancée avec une erreur telle que \"Signature invalide\". Si cela ne fonctionne toujours pas, renouvelez le certificat sans JIT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'app non si avvia e mostra l'errore \"Invalid Signature\" prova ad accedere nuovamente. Se continua a non funzionare, rinnova il certificato JIT-Less."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリが“Invalid Signature”のようなエラーで起動に失敗した場合は、再署名を試してください。それでもうまくいかない場合は、JITレス証明書を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'Invalid Signature' 오류가 뜰 경우 이 기능을 사용해주세요. 해결이 안 될 경우 JIT-Less 인증서를 재설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj podpisać ponownie, jeśli ta aplikacja się nie otworzyła i zwróciła błąd taki jak \"Nieprawidłowy Podpis\". Jeżeli nadal nie działa, odnów Certyfikat JIT-Less."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente assinar o aplicativo novamente se ele falhar para iniciar com um erro como \"Assinatura Inválida\". Se o erro permanecer, renove o Certificado JIT-Less."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте подписать заново, если это приложение не сможет запуститься с ошибкой о неправильной подписи. Если это не поможет, обновите сертификат режима JIT-less."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök att signera om appen misslyckades med att starta med fel som \"Ogiltig signatur\". Om detta fortfarande inte fungerar, förnya JIT-Less certifikat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama ‘Geçersiz İmza’ gibi bir hata ile başlatılamadıysa, tekrar imzalamayı deneyin. Eğer bu da işe yaramazsa, JIT-Less sertifikasını yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố gắng ký app lại nếu app không mở được do lỗi như 'Invalid Signature'. Nếu vẫn không được, hãy thử làm mới chứng chỉ JIT-less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果App启动时的报错包含“Invalid Signature”，则可以尝试强制重新签名。如果仍然报错，则可能需要刷新免JIT证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此應用程式無法啟動並出現「簽名無效」等錯誤，請再次嘗試簽名。 如果這仍然不起作用，請續訂JIT-Less證書。"
          }
        }
      }
    },
    "lc.appSettings.fspoofSDKVersionDesc": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنتحال نسخة SDK تجبر مكتبات النظام للعمل في نسخة SDK الذي صُمم التطبيق معها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spoofing der SDK-Version zwingt die Systembibliotheken, mit der SDK-Version zu arbeiten, mit der die Anwendung erstellt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoofing SDK version forces system libraries to operate in the SDK version the app is built with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsear la versión del SDK obliga a las bibliotecas del sistema a operar en la versión del SDK con la que se compiló la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version falsifiée du SDK force les bibliothèques système à fonctionner avec la version du SDK avec laquelle l'application a été construite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La falsificazione della versione SDK obbliga le librerie di sistema ad operare nella versione SDK dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDKバージョンを偽装することで、アプリがビルドされたSDKバージョンでシステムライブラリが動作するようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제로 앱이 만들어진 SDK 버전으로 시스템 라이브러리를 실행합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fałszowanie wersji SDK zmusza biblioteki systemowe do operowania w wersji SDK, w której aplikacja została zbudowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsificar a versão do SDK força as bibliotecas do sistema a funcionarem com a versão do SDK que o aplicativo foi criado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замена версии SDK заставляет системные библиотеки работать с версией SDK, с которой было собрано приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoofing SDK version tvingar systembibliotek att fungera i SDK-versionen som appen är byggd med."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SDK versiyonu taklit etme, sistem kitaplıklarının uygulamanın oluşturulduğu SDK sürümünde çalışmasını zorlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoof phiên bản SDK buộc các thư viện hệ thống hoạt động theo SDK mà app được build bằng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制指定SDK版本会使得系统库拥有App构建的SDK版本的行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偽裝 SDK 版本使系統庫以應用程式建置時的 SDK 版本運行。"
          }
        }
      }
    },
