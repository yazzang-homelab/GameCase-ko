          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz odinstalować %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja desinstalar %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите удалить %@?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
