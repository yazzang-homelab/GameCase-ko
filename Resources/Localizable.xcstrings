            "state": "translated",
            "value": "Das Schema \"%@\" kann von keiner in GameCase installierten App geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheme \"%@\" cannot be opened by any app installed in GameCase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esquema \"%@\" no se puede abrir con ninguna app instalada en GameCase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schéma \"%@\" ne peut être ouvert par aucune application installée dans GameCase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non può essere aperto da nessuna app installata in GameCase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーム \"%@\"はGameCaseにインストールしているアプリでは開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase로 설치된 앱은 \"%@\" Scheme을 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schemat \"%@\" nie może być otwarty przez żadną aplikację zainstalowaną w GameCase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquema \"%@\" não pôde ser aberto por qualquer aplicativo instalado no contêiner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема \"%@\" не может быть открыта ни одним установленным приложением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheme \"%@\" kan inte öppnas av någon app installerad i GameCase."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” şeması, GameCase içinde yüklü olan hiçbir uygulama tarafından açılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheme \"%@\" không thể được mở trong bất kỳ app nào cài trong GameCase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议“%@”无法被GameCase中安装的任何App打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝在GameCase中的任何應用程式都無法開啟方案「%@」。"
          }
        }
      }
    },
    "lc.appList.signSuccessWithError": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم توقيع التطبيق بنجاح، لكن GameCase لم يستطيع ان يُوقع الملفات التالية. يمكنك ان تستعمل التطبيق، لكن توقف مفاجئ على أي لحظه متوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde erfolgreich signiert, aber GameCase konnte die folgenden Dateien nicht signieren. Möglicherweise können Sie die App verwenden, rechnen Sie jedoch mit Abstürzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App was signed successfully, but GameCase was unable to sign the following files. You may be able to use the app, but do expect crash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se firmó correctamente, pero GameCase no pudo firmar los siguientes archivos. Es posible que puedas usar la app, pero espera fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a été signée avec succès, mais GameCase n'a pas pu signer les fichiers suivants. Vous pouvez utiliser l'application, mais attendez-vous à un crash."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è stata registrata con successo, ma GameCase non è stata in grado di registrare i seguenti file. Potresti essere in grado di usare l'app, ma aspettati dei crash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの署名に成功しましたが、GameCaseは以下のファイルに署名できませんでした。アプリは使用できますが、クラッシュする可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 설치가 완료되었으나, 일부 파일 서명에 실패했습니다. 앱 사용 도중 앱이 충돌할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z powodzeniem, Aplikacja została podpisana. Jednak GameCase nie był w stanie podpisać tych plików. Będziesz mieć możliwość używania aplikacji, ale oczekuj błędów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativo foi assinado com sucesso, porém o GameCase foi incapaz de assinar os seguintes arquivos. Você consegue utilizar o aplicativo, mas não possua expectativas de que não irá encerrar involuntariamente até certo ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было успешно подписано, но GameCase не смог подписать следующие файлы. Вы сможете воспользоваться приложением, но делайте это на свой страх и риск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen signerades framgångsrikt, men GameCase kunde inte signera följande filer. Du kanske kan använda appen, men förvänta dig krasch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama başarıyla imzalandı, ancak GameCase aşağıdaki dosyaları imzalayamadı. Uygulamayı kullanabilirsiniz, ancak çökme olasılığı vardır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đã được ký, nhưng GameCase không ký được các file sau đây. Bạn có thể dùng app, nhưng nó có thể văng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App签名成功，但以下文件签名失败。App有可能可以正常运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式已成功簽名，但GameCase無法簽署以下檔案。 您可能能夠使用該應用程式，但可能會崩潰。"
          }
        }
      }
    },
