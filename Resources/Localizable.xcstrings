    "lc.appSettings.addExternalNonLocalContainerWarningAlert": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة حاوية في وحدة تخزين غير محلية غير مدعومة من معظم التطبيقات وسوف يسبب سلوكا غير محدد بما في ذلك التعطل. هل تريد المتابعة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hinzufügen von Containern in einem nicht lokalen Speicher wird von den meisten Apps nicht unterstützt und führt zu unvorhersehbaren Verhaltensweisen, einschließlich Abstürzen. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a container in a non-local storage is not supported by most apps and will result in undefined behavior including crash. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un contenedor en un almacenamiento no local no es compatible con la mayoría de las apps y provocará un comportamiento indefinido, incluyendo fallos. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ajout d'un conteneur dans un stockage non local n'est pas pris en charge par la plupart des applications et provoquera un comportement indéfini, y compris un plantage. Continuer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルストレージ以外のストレージにコンテナを追加することは、ほとんどのアプリではサポートされておらず、クラッシュを始めとした不具合を引き起こす可能性があります。続行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 저장소에 컨테이너를 추가할 경우, 앱이 충돌할 수 있습니다. 계속하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawanie kontenera do pamięci masowej innej niż lokalna nie jest obsługiwane przez większość aplikacji i spowoduje nieoczekiwane zachowanie (w tym awarię). Kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar um contêiner em um armazenamento não local não é suportado pela maioria dos apps e resultará em comportamento indefinido, incluindo travamentos. Continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление контейнера в нелокальном хранилище не поддерживается большинством приложений и приведет к неопределённому поведению, включая сбой. Продолжить?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel olmayan bir depolama alanına konteyner eklemek çoğu uygulama tarafından desteklenmez ve çökme dahil olmak üzere tanımlanamayan davranışlara neden olur. Devam etmek istiyor musunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thùng chứa vào bộ nhớ ngoài không được hỗ trợ bởi đa số app và sẽ gây ra những hành vi không xác định bao gồm bị sập. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加不处于本地存储的数据文件夹不被大多数App支持，且会导致包括崩溃等的未定义行为。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增不位於本地存儲的資料夾不被大多數應用程式支援，且會導致包含當機等自訂行為，要繼續嗎？"
          }
        }
      }
    },
    "lc.appSettings.appOpenInOtherLc %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات هذا التطبيق حاليًا في %@. شغل %@ و اضغط على زر 'تطبيقاتي' وحاول مجدداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten dieser App befinden sich derzeit in %@. Öffnen Sie %@, starten Sie die App auf dem Bildschirm „Meine Apps“ und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data of this app is currently in %@. Open %@ and launch it to 'My Apps' screen and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de esta app están actualmente en %@. Abre %@ y lánzala desde la pantalla 'Mis apps' e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de cette application se trouvent actuellement dans %@. Ouvrez %@ et lancez-la dans l'écran \"Mes applications\", puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di questa app sono attualmente in %@. Apri %@ , avvia la schermata 'Le mie App' e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのデータは現在%@にあります。%@を開いて｢マイアプリ｣画面を表示してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱 데이터는 %@에 있습니다. %@(을)를 열고 앱 목록에 실행해보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane tej aplikacji są w %@. Otwórz %@ i przejdź do \"Moje Aplikacje\" oraz spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados deste aplicativo estão, atualmente, localizados em %@. Abra e mova %@ para a tela nomeada 'Meus Aplicativos' e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные этого приложения сейчас находятся в %@. Откройте %@ и запустите его на экране «Мои приложения» и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data för denna app finns för närvarande i %@. Öppna %@ och starta den till \"Mina appar\" skärmen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın verileri şu anda %@‘da bulunmaktadır. %@'yı açın ve 'Uygulamalarım’ ekranına gidin, ardından tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của app này đang được dùng bởi %@. Mở %@ và vào tab 'Ứng dụng của tôi' và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此App的数据当前在%@中。打开%@至App界面后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式的資料目前在%@。 開啟%@，將其啟動到「我的應用程式」螢幕，然後重試。"
          }
        }
      }
    },
