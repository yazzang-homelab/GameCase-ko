    "lc.gameSettings.resetDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉这个游戏在库里保存的全部启动器选择，回到打包时的默认值。按键布局不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears all launcher choices saved for this game in the library and goes back to the packaged defaults. Button layouts aren't affected."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todas as escolhas do launcher salvas para este jogo na biblioteca e volta aos padrões do pacote. O layout dos botões não é afetado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 저장된 이 게임의 런처 설정을 모두 지우고 패키지 기본값으로 되돌립니다. 버튼 배치는 영향을 받지 않습니다."
          }
        }
      }
    },
