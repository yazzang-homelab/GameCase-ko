            "value": "인증서를 찾을 수 없습니다. 내장 SideStore에 로그인 상태를 확인해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Certyfikat nie został znaleziony. Czy zalogowałeś się do wbudowanego SideStore?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado não encontrado. Você fez 'login' na SideStore integrada?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат не найден. Вы вошли в аккаунт во встроенном SideStore?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
