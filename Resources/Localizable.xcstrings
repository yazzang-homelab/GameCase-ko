            "state": "translated",
            "value": "解析容器书签超时。数据存储是否处于离线状态？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo esgotado ao resolver o marcador do contêiner. O armazenamento de dados está offline?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크 해석 시간이 초과되었습니다. 데이터 저장소가 오프라인 상태입니까?"
          }
        }
      }
    },
    "lc.bootstrap.error.bookmarkResolutionFailed %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark resolution failed or unable to access the container. You might need to readd the data storage. %@"
