    "lc.settings.notDevCert": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase غير موقع بشهادة مطورين لذاGameCase لا يعمل على الإطلاق. الرجاء توقيع GameCase بشهادة التطويير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase ist nicht mit einem Entwicklungszertifikat signiert, daher wird GameCase nicht funktionieren. Bitte signiert Sie GameCase mit einem Entwicklungszertifikat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase is not signed with a development certificate so GameCase won't work at all. Please sign GameCase with a development certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase no está firmado con un certificado de desarrollo, por lo que no funcionará en absoluto. Firma GameCase con un certificado de desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase n'est pas signé avec un certificat de développement, donc GameCase ne fonctionnera pas du tout. Veuillez signer GameCase avec un certificat de développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase non è firmato con un certificato development quindi GameCase non funzionerà. Firma GameCase con un certificato development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCaseは開発用の証明書で署名されていないため、動作しません。有効な開発用証明書で署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase를 사용할 수 없습니다. 개발용 인증서로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase nie jest podpisany certyfikatem deweloperskim, więc w ogóle nie będzie działać. Proszę podpisać certyfikatem deweloperskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GameCase não está assinado com um certificado de desenvolvimento, então o GameCase não irá funcionar. Por favor, assine o GameCase com um certificado de desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase не был подписан с сертификатом разработчика; GameCase не сможет работать. Пожалуйста, переподпишите его с действительным сертификатом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase, geliştirme sertifikası ile imzalanmadığından çalışmayacaktır. Lütfen GameCase'ı geliştirme sertifikası ile imzalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase không được ký với chứng chỉ phát triển nên GameCase không thể hoạt động. Vui lòng ký lại GameCase với chứng chỉ phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase未被使用开发证书签名，因此无法正常工作。请使用开发证书签名GameCase。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase未使用開發證書簽名，因此無法正常運作。請使用開發證書簽名GameCase。"
          }
        }
      }
    },
