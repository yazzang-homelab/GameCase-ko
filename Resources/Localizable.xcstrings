    "lc.settings.invalidCertError": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في التأكيد من صحة هذه الشهادة. الرجاء التأكد من صحة الرمز السري و أذا الشهادة الذي تم اختيارها هي نفسها الذي استخدمت لتوقيع GameCase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat konnte nicht validiert werden. Bitte überprüfen Sie das Passwort und ob das ausgewählte Zertifikat zum Signieren von GameCase verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to validate certificate. Please check the password and verify the selected certificate is used to sign GameCase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al validar el certificado. Comprueba la contraseña y verifica que el certificado seleccionado se usa para firmar GameCase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la validation du certificat. Veuillez vérifier le mot de passe et si le certificat sélectionné est utilisé pour signer GameCase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convalidare il certificato. Controlla la password e se il certificato selezionato è utilizzato per firmare GameCase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の検証に失敗しました。パスワードを確認して、選択した証明書がGameCaseの署名に使用されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서을 확인할 수 없습니다. GameCase를 서명하는데 사용한 인증서와 동일한지, 인증서 비밀번호가 올바른지 확인해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uprawomocnić certyfikatu. Proszę, sprawdź, czy hasło jest zgodne z certyfikatem użytym do podpisania GameCase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao validar certificado. Por favor, verifique a senha e se o devido certificado está sendo usando para assinar o GameCase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить сертификат. Пожалуйста, проверьте его пароль и убедитесь, что именно он был использован при подписи GameCase'а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att validera certifikatet. Kontrollera lösenordet och om det valda certifikatet används för att signera GameCase."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika doğrulanamadı. Lütfen şifreyi kontrol edin ve seçilen sertifikanın GameCase'ı imzalamak için kullanılıp kullanılmadığını kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác thực chứng chỉ. Vui lòng kiểm tra mật khẩu và có phải là chứng chỉ này được dùng để ký GameCase không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
