    "lc.settings.removeCertificateDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك أن تثبت تطبيقات بعد حذف الشهادة. هل تود المتابعه؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Entfernen des Zertifikats können Sie keine Anwendungen mehr installieren. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be able to install apps after removing the certificate. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás instalar apps después de eliminar el certificado. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez pas installer d'applications après avoir supprimé le certificat. Poursuivre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarai in grado di installare le app dopo aver rimosso il certificato. Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書を削除すると、アプリをインストールできなくなります。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 삭제 시 앱 설치가 불가능합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziesz mógł zainstalować aplikacji po usunięciu certyfikatu. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não será possível instalar aplicativos após remover o certificado. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не сможете устанавливать новые приложения после удаления сертификата. Хотите продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer inte att kunna installera appar efter att ha tagit bort certifikatet. Fortsätt?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikayı kaldırdıktan sonra uygulama yükleyemeyeceksiniz. Devam etmek istiyor musunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không thể cài app sau khi xoá chứng chỉ. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除证书后你无法签名App，要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除證書後不能安裝應用程式。"
          }
        }
      }
    },
