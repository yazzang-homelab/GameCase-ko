    "lc.settings.appGroupExist Shared": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ملفات في مجلد مجموعه التطبيقات المُشارَكه. قم بنقلها اولاً قم حاول مرة أخرى."
