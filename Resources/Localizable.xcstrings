            "state": "translated",
            "value": "Es gibt zu viele Apps in der aktuellen Repository, bitte stattdessen suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too many apps in current repository, please use search instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas apps en el repositorio actual, usa la búsqueda en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a trop d'applications dans le dépôt actuel, veuillez utiliser la recherche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のリポジトリにアプリが多すぎます。代わりに検索を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소에는 앱이 너무 많습니다. 검색을 사용하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W obecnym repozytorium znajduje się zbyt wiele aplikacji. Użyj wyszukiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há apps demais no repositório atual; use a busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом репозитории слишком много приложений, вместо этого используйте поиск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut depoda çok fazla uygulama var, lütfen arama özelliğini kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
