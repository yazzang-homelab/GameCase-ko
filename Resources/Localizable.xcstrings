    "lc.settings.multiLC.teamIdMismatch": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 مُوقع بشهادة أخرى عن GameCase, لذلك لن يعمل. الرجاء تثبيت GameCase2 بِنفس الحساب الذي استخدمته لتثبيت GameCase"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 ist mit einem anderen Zertifikat signiert als GameCase, daher wird es nicht funktionieren. Bitte installieren Sie GameCase2 mit demselben Account, den Sie für die Installation von GameCase verwendet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 is signed with a different certificate from GameCase, so it will not work. Please install GameCase2 with the same account you used to install GameCase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 está firmado con un certificado distinto al de GameCase, por lo que no funcionará. Instala GameCase2 con la misma cuenta que usaste para instalar GameCase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 est signé avec un certificat différent de GameCase, donc il ne fonctionnera pas. Veuillez installer GameCase2 avec le même compte que celui utilisé pour installer GameCase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 è firmato con un certificato diverso da GameCase, quindi non funzionerà. Si prega di installare GameCase2 con lo stesso account usato per installare GameCase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase 2はGameCaseと異なる証明書で署名されているため、動作しません。GameCaseをインストールしたのと同じアカウントでGameCase 2をインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서가 일치하지 않습니다. GameCase 설치할 때 사용한 동일한 계정으로 GameCase2를 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 jest podpisany innym certyfikatem niż GameCase, więc nie będzie działać. Proszę, zainstalować GameCase2 używając tego samego konta, którego użyto przy instalacji GameCase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner secundário está assinado com um certificado diferente do contêiner primário, então não funcionará. Por favor, instale o contêiner secundário com o mesmo certificado usado para assinar o contêiner primário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй GameCase подписан сертификатом, отличным от использованного с основным GameCase; он не будет работать. Переустановите второй GameCase с тем же аккаунтом, который вы использовали для подписи первого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 är signerad med ett annat certifikat än GameCase, så det fungerar inte. Installera GameCase2 med samma konto du använde för att installera GameCase."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2, GameCase'dan farklı bir sertifika ile imzalanmıştır, bu nedenle çalışmayacaktır. Lütfen GameCase2'yi GameCase'ı yüklemek için kullandığınız aynı hesapla yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2 đã được cài với chứng chỉ khác so với GameCase, nên sẽ không dùng được. Vui lòng cài GameCase2 với cùng tài khoản bạn đã dùng để cài GameCase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名GameCase2和GameCase所使用的证书不一致，GameCase2无法正常工作。请使用签名GameCase的账户安装GameCase2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase2使用與GameCase不同的證書簽名，因此它將無法工作。 請使用您用於安裝GameCase的同一帳戶安裝GameCase2。"
          }
        }
      }
    },
    "lc.settings.multiLCDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتثبيت عده GameCase، وتحويل عده تطبيقات الى تطبيقات مُشارَكه، يمكنك فتح تطبيق واحد بين جميع GameCase مع جميع ملفاتها وبياناتها وأعداداتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Installation mehrerer GameCase und die Konvertierung von Apps in geteilte Apps können Sie eine App in allen GameCasen mit den meisten ihrer Daten und Einstellungen öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By installing multiple GameCases, and converting apps to Shared Apps, you can open one app between all GameCases with most of its data and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalando múltiples GameCase y convirtiendo las apps en Apps Compartidas, puedes abrir una app entre todos los GameCase conservando la mayoría de sus datos y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En installant plusieurs GameCase et en convertissant les applications en apps partagées, vous pouvez ouvrir une application entre tous les GameCase avec la plupart de ses données et paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installando più GameCase e convertendo app in applicazioni condivise, è possibile aprire un'app tra tutti i GameCase con la maggior parte dei suoi dati e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のGameCaseをインストールし、アプリを共有アプリに変換することで、ほとんどのデータや設定を保持したまま、すべてのGameCase間で1つのアプリを開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameCase를 여러 개 설치할 경우, 앱 여러 개를 동시에 실행할 수 있습니다. (설치한 앱은 공유된 앱으로 변환해야 합니다.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalując wiele GameCase’ów i zmieniając aplikacje w Aplikacje Współdzielonych, możesz otworzyć jedną aplikację między wszystkimi GameCase’ami, nie tracąc żadnych ustawień czy danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao instalar múltiplos contêineres, e converter os aplicativos em Aplicativos Compartilhados, você consegue abrir um aplicativo entre todos os contêineres com a maioria de seus dados e configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установив несколько GameCase'ов, вы сможете открывать приложения, преобразованные в общие, на всех GameCase'ах с сохранением большинства данных и настроек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att installera flera GameCase och konvertera appar till delade appar kan du öppna en app mellan alla GameCase med de flesta av dess data och inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla GameCase kurup uygulamaları Paylaşılan Uygulamalar’a dönüştürerek; paylaştığınız uygulamaları tüm GameCase’larda, uygulama ayarları ve verileriyle birlikte kullanabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách cài đặt nhiều GameCase và chuyển đổi app thành App được Chia sẻ, bạn có thể mở app giữa tất cả các GameCase với hầu hết dữ liệu và cài đặt của app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过安装多个GameCase，并将App变为共享App，你可以在这些GameCase间共享安装的App及其数据，并同时运行多个App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過安裝多個GameCase，並將App變成共享App，你可以在這些GameCase間共享安裝的App和其數據，並同時執行多個App。"
          }
        }
      }
    },
